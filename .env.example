# Copy this file to .env to change settings. The project also works without .env.

# USGS Earthquake Catalog API (no API key needed)
API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
API_START_TIME=2026-10-01
API_END_TIME=2026-11-01
API_MIN_MAGNITUDE=2.5
API_LIMIT=20000
API_TIMEOUT=30
API_MAX_RETRIES=3

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=earthquakes
